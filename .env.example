# Copy to .env.local for local dev. Never commit real values. Only the Supabase PUBLISHABLE key ever goes here.
# Contact adapter: supabase | http | mailto   (dev/test only: mock — ignored in production builds)
#   unset → mock in `npm run dev`; production → supabase if URL+key set, else mailto.
NEXT_PUBLIC_CONTACT_ADAPTER=supabase
# AMR project (https://supabase.com/dashboard/project/khucmrlbstdlbxcuboub)
NEXT_PUBLIC_SUPABASE_URL=https://khucmrlbstdlbxcuboub.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_0b1_bw1g9VUc1H6ROJp0Mw_VWsTOHDb
NEXT_PUBLIC_CONTACT_ENDPOINT=          # http adapter only, e.g. https://example.vercel.app/api/contact
NEXT_PUBLIC_SITE_URL=https://amrslam.tech
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_CONTROL_PANEL_URL=          # empty → /login/ → /control/ (live remote panel) when auth is live
# Pi bridge (amr-bridge/) uses AMR_* vars on the robot — never put the service role in NEXT_PUBLIC_*

# Auth (login-spec §1.6–1.7). Default: supabase if URL+key exist, else none in production / mock in dev.
# Passwords live in Supabase Auth (bcrypt) — create users in Dashboard → Authentication → Users.
NEXT_PUBLIC_AUTH_ADAPTER=supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=             # legacy anon JWT; PUBLISHABLE_KEY above is preferred
NEXT_PUBLIC_AUTH_REDIRECT_ALLOWLIST=https://bot.amrslam.tech
NEXT_PUBLIC_PRIVATE_CONTROL=            # unset/0 → public amr-bot-* channel. Exactly "1" opts into a private channel (needs DB policies; leave off).
NEXT_PUBLIC_MAINTENANCE=                   # 1 → every route is the maintenance page (build-time)
NEXT_PUBLIC_MAINTENANCE_UNTIL=             # optional ISO timestamp, shown in Asia/Kolkata
