{
  "name": "amrslam-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/check-figures.ts && node scripts/check-diagrams.mjs && tsx scripts/check-media.ts",
    "build": "next build",
    "render:diagrams": "node scripts/render-diagrams.mjs",
    "start": "serve out -l 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "bake:camera": "tsx scripts/bake-camera.ts",
    "check:budgets": "node scripts/check-budgets.mjs",
    "postbuild": "node scripts/csp-meta.mjs && node scripts/check-budgets.mjs && node scripts/check-subpages.mjs",
    "test:e2e": "playwright test",
    "capture:stills": "node scripts/capture-stills.mjs",
    "bake:map": "node scripts/apartment/bake-map.mjs",
    "check:path": "node scripts/apartment/check-path.mjs",
    "bake:floor-ao": "node scripts/apartment/bake-floor-ao.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@google/model-viewer": "4.4.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.2.0",
    "@supabase/supabase-js": "2.117.3",
    "lenis": "1.3.26",
    "n8ao": "2.0.1",
    "next": "16.4.0",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.16",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "serve": "14.2.5",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "@google/model-viewer": {
      "three": "$three"
    }
  }
}
